/// A value that may be missing: `Some(x)`, or `None`.
#[derive(Discard, Copy, Eq)]
export enum core::option::Option::<&u8> { None, Some(&u8) }

/// A value that may be missing: `Some(x)`, or `None`.
#[derive(Discard, Copy)]
export enum core::option::Option::<core::slice::Split<u8>> { None, Some(core::slice::Split::<u8>) }

/// What `split_at` gives: the values before the index it's given, and
/// those from it on.
#[derive(Discard, Copy)]
export struct core::slice::Split::<u8><'a> { export head: &'a [u8], export tail: &'a [u8] }

/// What `iter` gives: a reference to each value of `rest`, front to back.
#[derive(Discard)]
export struct core::slice::Iter::<u8><'a> { rest: &'a [u8] }

