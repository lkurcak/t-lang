/// What kind of failure an `Error` is.
#[derive(Discard, Copy, Eq)]
export enum core::io::ErrorKind {
    /// What was asked for isn't there: a file, say.
    NotFound,
    /// The operating system doesn't let the program do it.
    PermissionDenied,
    /// What was to be made is there already.
    AlreadyExists,
    /// What's at the other end went away: a pipe's reader, say.
    BrokenPipe,
    /// What was read isn't what was asked for: text that isn't UTF-8.
    InvalidData,
    /// The input ended before what was asked for was read.
    UnexpectedEnd,
    /// It can't be done here: on this operating system, or this stream.
    Unsupported,
    /// What it was given can't be right: a path with a `\0` in it, say.
    InvalidInput,
    /// Something else.
    Other,
}

/// Why reading or writing failed: its kind, and the operating system's
/// own number for it, if the operating system said so.
#[derive(Discard, Copy, Eq)]
export struct core::io::Error {
    kind: core::io::ErrorKind,
    /// The operating system's number for it (`errno`), or 0 if it didn't
    /// come from the operating system: no failure there is 0.
    code: i32,
}

/// Whether to go on, with a `C`, or stop early, with a `B`.
#[derive(Discard, Copy, Eq)]
export enum core::ops::ControlFlow::<core::result::Result<!, core::io::Error>, ()> {
    Continue(()),
    Break(core::result::Result::<!, core::io::Error>),
}

/// A value that may be missing: `Some(x)`, or `None`.
#[derive(Discard, Copy, Eq)]
export enum core::option::Option::<&u8> { None, Some(&u8) }

/// A value that may be missing: `Some(x)`, or `None`.
#[derive(Discard, Copy)]
export enum core::option::Option::<core::slice::Split<u8>> { None, Some(core::slice::Split::<u8>) }

/// What worked, `Ok(x)`, or why it didn't, `Err(e)`.
#[derive(Discard, Copy, Eq)]
export enum core::result::Result::<(), core::io::Error> { Ok(()), Err(core::io::Error) }

/// What worked, `Ok(x)`, or why it didn't, `Err(e)`.
#[derive(Discard, Copy, Eq)]
export enum core::result::Result::<!, core::io::Error> { Ok(!), Err(core::io::Error) }

/// What `split_at` gives: the values before the index it's given, and
/// those from it on.
#[derive(Discard, Copy)]
export struct core::slice::Split::<u8><'a> { export head: &'a [u8], export tail: &'a [u8] }

/// What `iter` gives: a reference to each value of `rest`, front to back.
#[derive(Discard)]
export struct core::slice::Iter::<u8><'a> { rest: &'a [u8] }

