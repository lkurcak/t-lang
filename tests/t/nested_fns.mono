#[derive(Discard)]
struct Holder { f: fn(i64) -> i64 with panic }

#[derive(Discard)]
struct One { n: i64 }

fn main(os: std::Os) -> core::result::Result::<(), std::io::Error> with panic {
    let mut out = os.stdout;
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &main::double(1i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &main::fact(5i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<bool>(&mut out, &main::is_even(10i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<bool>(&mut out, &main::is_odd(10i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &main::twice::<i64>(main::double, 3i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<bool>(&mut out, &main::twice::<bool>(|b| !b, true)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &main::sum_to(4i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    let k = 3i64;
    let add_k = |x: i64| { main::inc(x) + k };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &(&add_k)(1i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    let f = pick(true);
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &f(7i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &top()),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    core::result::Result::<(), std::io::Error>::Ok(())
}

/// Doubles `x`.
fn main::double(x: i64) -> i64 with panic { x * 2i64 }

fn main::fact(n: i64) -> i64 with panic {
    if n == 0i64 { 1i64 } else { n * main::fact(n - 1i64) }
}

fn main::is_even(n: i64) -> bool with panic {
    if n == 0i64 { true } else { main::is_odd(n - 1i64) }
}

fn main::is_odd(n: i64) -> bool with panic {
    if n == 0i64 { false } else { main::is_even(n - 1i64) }
}

fn main::twice::<i64>(f: fn(i64) -> i64 with panic, x: i64) -> i64 with panic { f(f(x)) }

fn main::twice::<bool>(f: fn(bool) -> bool with panic, x: bool) -> bool with panic { f(f(x)) }

fn main::sum_to(n: i64) -> i64 with panic { main::sum_to::go(1i64, 0i64, n) }

fn main::sum_to::go(i: i64, acc: i64, n: i64) -> i64 with panic {
    if i > n { acc } else { main::sum_to::go(i + 1i64, acc + i, n) }
}

fn main::inc(x: i64) -> i64 with panic { x + 1i64 }

fn pick(b: bool) -> fn(i64) -> i64 with panic {
    if b { double_it() } else { pick::neg }
}

fn pick::neg(x: i64) -> i64 with panic { -x }

fn double_it() -> fn(i64) -> i64 with panic {
    let h = Holder { f: double_it::double };
    h.f
}

fn double_it::double(x: i64) -> i64 with panic { x + x }

fn top() -> i64 { top::one().n }

fn top::one() -> One { One { n: 1i64 } }

fn <&str as core::fmt::Display>::fmt::<std::io::Stderr><'a>(
    &self,
    w: &mut std::io::Stderr,
) -> core::result::Result::<(), std::io::Error> {
    <std::io::Stderr as core::fmt::Write>::write_str(&mut *w, *self)
}
