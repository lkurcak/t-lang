fn adder(n: i64) -> {closure#81536} { move |x| x + n }

fn counter() -> {closure#81635} {
    let mut n = 0i64;
    move || {
        n += 1i64;
        n
    }
}

fn compose::<{panic}, {closure#81536}, {closure#81536}>(
    f: {closure#81536},
    g: {closure#81536},
) -> {closure#81843}::<{panic}, {closure#81536}, {closure#81536}> { move |x| (&g)((&f)(x)) }

fn pick(c: bool) -> {closure#81536} {
    let a = adder(1i64);
    let b = adder(2i64);
    if c { a } else { b }
}

