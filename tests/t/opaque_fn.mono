fn adder(n: i64) -> {closure#53058} { move |x| x + n }

fn counter() -> {closure#53157} {
    let mut n = 0i64;
    move || {
        n += 1i64;
        n
    }
}

fn compose::<{panic}, {closure#53058}, {closure#53058}>(
    f: {closure#53058},
    g: {closure#53058},
) -> {closure#53365}::<{panic}, {closure#53058}, {closure#53058}> { move |x| (&g)((&f)(x)) }

fn pick(c: bool) -> {closure#53058} {
    let a = adder(1i64);
    let b = adder(2i64);
    if c { a } else { b }
}

fn main() with panic {
    let add5 = adder(5i64);
    print((&add5)(1i64));
    let mut c = counter();
    print((&mut c)());
    print((&mut c)());
    let h = compose::<{panic}, {closure#53058}, {closure#53058}>(adder(1i64), adder(10i64));
    print((&h)(0i64));
    print((&pick(false))(0i64));
    print((&adder(2i64))(3i64));
}
