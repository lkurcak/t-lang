fn adder(n: i64) -> {closure#64437} { move |x| x + n }

fn counter() -> {closure#64536} {
    let mut n = 0i64;
    move || {
        n += 1i64;
        n
    }
}

fn compose::<{panic}, {closure#64437}, {closure#64437}>(
    f: {closure#64437},
    g: {closure#64437},
) -> {closure#64744}::<{panic}, {closure#64437}, {closure#64437}> { move |x| (&g)((&f)(x)) }

fn pick(c: bool) -> {closure#64437} {
    let a = adder(1i64);
    let b = adder(2i64);
    if c { a } else { b }
}

fn main() with panic {
    let add5 = adder(5i64);
    print((&add5)(1i64));
    let mut c = counter();
    print((&mut c)());
    print((&mut c)());
    let h = compose::<{panic}, {closure#64437}, {closure#64437}>(adder(1i64), adder(10i64));
    print((&h)(0i64));
    print((&pick(false))(0i64));
    print((&adder(2i64))(3i64));
}
