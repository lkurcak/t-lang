fn adder(n: i64) -> {closure#52826} { move |x| x + n }

fn counter() -> {closure#52925} {
    let mut n = 0i64;
    move || {
        n += 1i64;
        n
    }
}

fn compose::<{panic}, {closure#52826}, {closure#52826}>(
    f: {closure#52826},
    g: {closure#52826},
) -> {closure#53126}::<{panic}, {closure#52826}, {closure#52826}> { move |x| (&g)((&f)(x)) }

fn pick(c: bool) -> {closure#52826} {
    let a = adder(1i64);
    let b = adder(2i64);
    if c { a } else { b }
}

fn main() with panic {
    let add5 = adder(5i64);
    print((&add5)(1i64));
    let mut c = counter();
    print((&mut c)());
    print((&mut c)());
    let h = compose::<{panic}, {closure#52826}, {closure#52826}>(adder(1i64), adder(10i64));
    print((&h)(0i64));
    print((&pick(false))(0i64));
    print((&adder(2i64))(3i64));
}
