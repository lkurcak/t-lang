#[derive(Discard)]
struct P { x: i64 }

/// Two of the top-level `P`.
#[derive(Discard)]
struct total::Pair { left: P, right: P }

#[derive(Discard)]
enum shapes::Shape::<i64> { Circle(i64), Rect(i64, i64), Empty }

#[derive(Discard)]
struct main::P { y: bool }

#[derive(Discard)]
struct main::Q { n: i64 }

#[derive(Discard)]
struct main::P#2 { z: i64 }

#[derive(Discard)]
struct other::P { y: i64 }

#[derive(Discard)]
enum outer::inner::Sign { Minus, Plus }

fn total() -> i64 with panic {
    let pair = total::Pair { left: P { x: 1i64 }, right: P { x: 2i64 } };
    total::sum(pair)
}

fn total::sum(p: total::Pair) -> i64 with panic { p.left.x + p.right.x }

fn shapes() -> i64 with panic {
    shapes::area(shapes::Shape::<i64>::Circle(2i64))
        + shapes::area(shapes::Shape::<i64>::Rect(2i64, 3i64))
        + shapes::area(shapes::Shape::<i64>::Empty)
}

fn shapes::area(s: shapes::Shape::<i64>) -> i64 with panic {
    match s {
        shapes::Shape::<i64>::Circle(r) => 3i64 * r * r,
        shapes::Shape::<i64>::Rect(w, h) => w * h,
        shapes::Shape::<i64>::Empty => 0i64,
    }
}

fn main(os: std::Os) -> core::result::Result::<(), std::io::Error> with panic {
    let mut out = os.stdout;
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &total()),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &shapes()),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<bool>(&mut out, &(main::P { y: true }).y),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    let q = { main::Q { n: 7i64 } };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &q.n),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    {
        let main::P#2 { z } = main::P#2 { z: 9i64 };
        match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
            <std::io::Stdout>::line::<i64>(&mut out, &z),
        ) {
            core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
                {try},
            ) => {try},
            core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
                {try},
            ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
                {try},
            ),
        };
    }
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &other()),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &outer()),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    core::result::Result::<(), std::io::Error>::Ok(())
}

fn other() -> i64 { (other::P { y: 4i64 }).y }

fn outer() -> i64 with panic { outer::inner() }

fn outer::inner() -> i64 with panic {
    outer::inner::value(outer::inner::Sign::Plus)
        + outer::inner::value(outer::inner::Sign::Minus)
        + outer::inner::value(outer::inner::Sign::Plus)
}

fn outer::inner::value(s: outer::inner::Sign) -> i64 {
    match s {
        outer::inner::Sign::Minus => -5i64,
        outer::inner::Sign::Plus => 5i64,
    }
}

fn <&str as core::fmt::Display>::fmt::<std::io::Stderr><'a>(
    &self,
    w: &mut std::io::Stderr,
) -> core::result::Result::<(), std::io::Error> {
    <std::io::Stderr as core::fmt::Write>::write_str(&mut *w, *self)
}
