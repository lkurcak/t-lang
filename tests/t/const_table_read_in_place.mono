export fn <[(u32, u32); 4]>::as_mut_slice(
    &mut self,
) -> { s: &mut [(u32, u32)] | s.len() == old(self.len()) };

/// The value at `i`, which is less than `len()`, to change: `s[i] = v`
/// is `*s.index_mut(i) = v`.
#[intrinsic]
export fn <[(u32, u32)]>::index_mut(&mut self, i: { i: usize | i < self.len() }) -> &mut (u32, u32);

/// All its values, as a slice.
#[intrinsic]
export fn <[(u32, u32); 4]>::as_slice(&self) -> { s: &[(u32, u32)] | s.len() == self.len() };

/// The value at `i`, which is less than `len()`, so there's one: `s[i]`
/// is `*s.index(i)`.
#[intrinsic]
export fn <[(u32, u32)]>::index(&self, i: { i: usize | i < self.len() }) -> &(u32, u32);

/// All its values, as a slice.
#[intrinsic]
export fn <[u32; 2]>::as_slice(&self) -> { s: &[u32] | s.len() == self.len() };

/// The value at `i`, which is less than `len()`, so there's one: `s[i]`
/// is `*s.index(i)`.
#[intrinsic]
export fn <[u32]>::index(&self, i: { i: usize | i < self.len() }) -> &u32;
