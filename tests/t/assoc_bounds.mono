#[derive(Discard)]
struct A { n: i64 }

#[derive(Discard)]
struct B { b: bool }

#[derive(Discard)]
struct W::<A> { t: A }

#[derive(Discard)]
struct Count::<A> { of: A, n: i64 }

#[derive(Discard)]
struct Hold::<i64><'r> { u: i64, r: &'r i64 }

fn shown::<W<A>>(s: &W::<A>) -> i64 with panic { <W::<A> as Show>::show(&*s) }

fn count::<A>(of: A) -> Count::<A> with panic {
    let n = <A as Tr>::out(&of) + 1i64;
    Count::<A> { of, n }
}

fn same::<A>(x: &A, y: &A) -> bool { <A as Tr>::out(&*x) == <A as Tr>::out(&*y) }

fn same::<B>(x: &B, y: &B) -> bool { <B as Tr>::out(&*x) == <B as Tr>::out(&*y) }

fn hold::<A><'r>(t: &A, r: &'r i64) -> i64 {
    let h: Hold::<i64><'r> = Hold::<i64> { u: <A as Tr>::out(&*t), r };
    *h.r
}

fn main(os: std::Os) -> core::result::Result::<(), std::io::Error> with panic {
    let mut out = os.stdout;
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &shown::<W<A>>(&W::<A> { t: A { n: 4i64 } })),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    let c = count::<A>(A { n: 1i64 });
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &(c.n + c.of.n)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<bool>(&mut out, &same::<A>(&A { n: 1i64 }, &A { n: 1i64 })),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<bool>(&mut out, &same::<B>(&B { b: true }, &B { b: false })),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &hold::<A>(&A { n: 1i64 }, &5i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    core::result::Result::<(), std::io::Error>::Ok(())
}

fn <&str as core::fmt::Display>::fmt::<std::io::Stderr><'a>(
    &self,
    w: &mut std::io::Stderr,
) -> core::result::Result::<(), std::io::Error> {
    <std::io::Stderr as core::fmt::Write>::write_str(&mut *w, *self)
}

fn <A as Tr>::out(&self) -> i64 { self.n }

fn <B as Tr>::out(&self) -> bool { self.b }

fn <W::<A> as Show>::show(&self) -> i64 with panic { <A as Tr>::out(&self.t) * 10i64 }
