#[derive(Discard)]
enum Option::<i64> { Some(i64), None }

#[derive(Discard)]
enum Option::<Pair<Option<i64>, i64>> { Some(Pair::<Option<i64>, i64>), None }

#[derive(Discard)]
enum Option::<bool> { Some(bool), None }

#[derive(Discard)]
struct Pair::<i64, bool> { first: i64, second: bool }

#[derive(Discard)]
struct Pair::<Option<i64>, i64> { first: Option::<i64>, second: i64 }

#[derive(Discard)]
struct Pair::<bool, i64> { first: bool, second: i64 }

fn id::<i64>(x: i64) -> i64 { x }

fn id::<bool>(x: bool) -> bool { x }

fn flip::<i64, bool>(p: Pair::<i64, bool>) -> Pair::<bool, i64> {
    Pair::<bool, i64> { first: p.second, second: p.first }
}

fn map::<{panic}, i64, i64, {closure#80150}>(o: Option::<i64>, f: {closure#80150}) -> Option::<i64>
with panic
{
    match o {
        Option::<i64>::Some(x) => Option::<i64>::Some(f(x)),
        Option::<i64>::None => Option::<i64>::None,
    }
}

fn map::<{panic}, i64, i64, fn(i64) -> i64 with panic>(
    o: Option::<i64>,
    f: fn(i64) -> i64 with panic,
) -> Option::<i64> with panic {
    match o {
        Option::<i64>::Some(x) => Option::<i64>::Some(f(x)),
        Option::<i64>::None => Option::<i64>::None,
    }
}

fn map::<{}, i64, bool, fn(i64) -> bool>(o: Option::<i64>, f: fn(i64) -> bool) -> Option::<bool> {
    match o {
        Option::<i64>::Some(x) => Option::<bool>::Some(f(x)),
        Option::<i64>::None => Option::<bool>::None,
    }
}

fn unwrap_or::<i64>(o: Option::<i64>, default: i64) -> i64 {
    match o {
        Option::<i64>::Some(x) => x,
        Option::<i64>::None => default,
    }
}

fn unwrap_or::<bool>(o: Option::<bool>, default: bool) -> bool {
    match o {
        Option::<bool>::Some(x) => x,
        Option::<bool>::None => default,
    }
}

fn twice::<i64>(f: fn(i64) -> i64 with panic, x: i64) -> i64 with panic { f(id::<i64>(f(x))) }

fn repeat::<i64>(f: fn(i64) -> i64 with panic, x: i64, n: i64) -> i64 with panic {
    if n == 0i64 { x } else { repeat::<i64>(f, f(x), n - 1i64) }
}

fn inc(x: i64) -> i64 with panic { x + 1i64 }

fn main(os: std::Os) -> core::result::Result::<(), std::io::Error> with panic {
    let mut out = os.stdout;
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &id::<i64>(1i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<bool>(&mut out, &id::<bool>(true)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    let p = flip::<i64, bool>(Pair::<i64, bool> { first: 1i64, second: false });
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<bool>(&mut out, &p.first),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &p.second),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    let n: i64 = 10i64;
    let o = map::<{panic}, i64, i64, {closure#80150}>(Option::<i64>::Some(4i64), |x| x * n);
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &unwrap_or::<i64>(o, 0i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    let none: Option::<i64> = Option::<i64>::None;
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(
            &mut out,
            &unwrap_or::<i64>(
                map::<{panic}, i64, i64, fn(i64) -> i64 with panic>(none, |x| x + 1i64),
                -1i64,
            ),
        ),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<bool>(
            &mut out,
            &unwrap_or::<bool>(
                map::<{}, i64, bool, fn(i64) -> bool>(Option::<i64>::Some(3i64), |x| x > 2i64),
                false,
            ),
        ),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &twice::<i64>(inc, 0i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &repeat::<i64>(|x| x * 2i64, 1i64, 10i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    let nested = Option::<Pair<Option<i64>, i64>>::Some(Pair::<Option<i64>, i64> {
        first: Option::<i64>::Some(1i64),
        second: 2i64,
    });
    match nested {
        Option::<Pair<Option<i64>, i64>>::Some(
            Pair::<Option<i64>, i64> { first: Option::<i64>::Some(a), second: b },
        ) => match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
            <std::io::Stdout>::line::<i64>(&mut out, &(a + b)),
        ) {
            core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
                {try},
            ) => {try},
            core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
                {try},
            ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
                {try},
            ),
        },
        _ => match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
            <std::io::Stdout>::line::<i64>(&mut out, &0i64),
        ) {
            core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
                {try},
            ) => {try},
            core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
                {try},
            ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
                {try},
            ),
        },
    }
    match <core::result::Result::<(), std::io::Error> as core::ops::Try>::branch(
        <std::io::Stdout>::line::<i64>(&mut out, &twice::<i64>(id::<i64>, 7i64)),
    ) {
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Continue(
            {try},
        ) => {try},
        core::ops::ControlFlow::<core::result::Result<!, std::io::Error>, ()>::Break(
            {try},
        ) => return <core::result::Result::<(), std::io::Error> as core::ops::Try>::from_residual(
            {try},
        ),
    };
    core::result::Result::<(), std::io::Error>::Ok(())
}

fn <&str as core::fmt::Display>::fmt::<std::io::Stderr><'a>(
    &self,
    w: &mut std::io::Stderr,
) -> core::result::Result::<(), std::io::Error> {
    <std::io::Stderr as core::fmt::Write>::write_str(&mut *w, *self)
}
