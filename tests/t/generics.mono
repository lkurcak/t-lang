#[derive(Discard)]
enum Option::<int> { Some(int), None }

#[derive(Discard)]
enum Option::<Pair<Option<int>, int>> { Some(Pair::<Option<int>, int>), None }

#[derive(Discard)]
enum Option::<bool> { Some(bool), None }

#[derive(Discard)]
struct Pair::<int, bool> { first: int, second: bool }

#[derive(Discard)]
struct Pair::<Option<int>, int> { first: Option::<int>, second: int }

#[derive(Discard)]
struct Pair::<bool, int> { first: bool, second: int }

fn id::<int>(x: int) -> int { x }

fn id::<bool>(x: bool) -> bool { x }

fn flip::<int, bool>(p: Pair::<int, bool>) -> Pair::<bool, int> {
    Pair::<bool, int> { first: p.second, second: p.first }
}

fn map::<{panic}, int, int, {closure#1619}>(o: Option::<int>, f: {closure#1619}) -> Option::<int>
with panic
{
    match o {
        Option::<int>::Some(x) => Option::<int>::Some(f(x)),
        Option::<int>::None => Option::<int>::None,
    }
}

fn map::<{panic}, int, int, fn(int) -> int with panic>(
    o: Option::<int>,
    f: fn(int) -> int with panic,
) -> Option::<int> with panic {
    match o {
        Option::<int>::Some(x) => Option::<int>::Some(f(x)),
        Option::<int>::None => Option::<int>::None,
    }
}

fn map::<{}, int, bool, fn(int) -> bool>(o: Option::<int>, f: fn(int) -> bool) -> Option::<bool> {
    match o {
        Option::<int>::Some(x) => Option::<bool>::Some(f(x)),
        Option::<int>::None => Option::<bool>::None,
    }
}

fn unwrap_or::<int>(o: Option::<int>, default: int) -> int {
    match o {
        Option::<int>::Some(x) => x,
        Option::<int>::None => default,
    }
}

fn unwrap_or::<bool>(o: Option::<bool>, default: bool) -> bool {
    match o {
        Option::<bool>::Some(x) => x,
        Option::<bool>::None => default,
    }
}

fn twice::<int>(f: fn(int) -> int with panic, x: int) -> int with panic { f(id::<int>(f(x))) }

fn repeat::<int>(f: fn(int) -> int with panic, x: int, n: int) -> int with panic {
    if n == 0 { x } else { repeat::<int>(f, f(x), n - 1) }
}

fn inc(x: int) -> int with panic { x + 1 }

fn main() with panic {
    print(id::<int>(1));
    print_bool(id::<bool>(true));
    let p = flip::<int, bool>(Pair::<int, bool> { first: 1, second: false });
    print_bool(p.first);
    print(p.second);
    let n = 10;
    let o = map::<{panic}, int, int, {closure#1619}>(Option::<int>::Some(4), |x| x * n);
    print(unwrap_or::<int>(o, 0));
    let none: Option::<int> = Option::<int>::None;
    print(unwrap_or::<int>(
        map::<{panic}, int, int, fn(int) -> int with panic>(none, |x| x + 1),
        -1,
    ));
    print_bool(unwrap_or::<bool>(
        map::<{}, int, bool, fn(int) -> bool>(Option::<int>::Some(3), |x| x > 2),
        false,
    ));
    print(twice::<int>(inc, 0));
    print(repeat::<int>(|x| x * 2, 1, 10));
    let nested = Option::<Pair<Option<int>, int>>::Some(Pair::<Option<int>, int> {
        first: Option::<int>::Some(1),
        second: 2,
    });
    match nested {
        Option::<Pair<Option<int>, int>>::Some(
            Pair::<Option<int>, int> { first: Option::<int>::Some(a), second: b },
        ) => print(a + b),
        _ => print(0),
    }
    print(twice::<int>(id::<int>, 7));
}
