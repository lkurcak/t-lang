fn count::<bool>(_x: bool, n: i64) -> i64 with panic {
    if n == 0i64 { 0i64 } else { 1i64 + count::<i64>(n, n - 1i64) }
}

fn count::<i64>(_x: i64, n: i64) -> i64 with panic {
    if n == 0i64 { 0i64 } else { 1i64 + count::<i64>(n, n - 1i64) }
}

fn flip::<i64, bool>(a: i64, b: bool, n: i64) -> i64 with panic {
    if n == 0i64 { 0i64 } else { 1i64 + flip::<bool, i64>(b, a, n - 1i64) }
}

fn flip::<bool, i64>(a: bool, b: i64, n: i64) -> i64 with panic {
    if n == 0i64 { 0i64 } else { 1i64 + flip::<i64, bool>(b, a, n - 1i64) }
}

fn main() with panic {
    print(count::<bool>(true, 5i64));
    print(flip::<i64, bool>(1i64, false, 4i64));
}
